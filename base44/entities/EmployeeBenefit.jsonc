{
  "name": "EmployeeBenefit",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "employee_id": {
      "type": "string",
      "description": "Reference to Employee entity"
    },
    "employee_name": {
      "type": "string"
    },
    "benefit_id": {
      "type": "string",
      "description": "Reference to Benefit entity"
    },
    "benefit_name": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "employee_contribution": {
      "type": "number",
      "default": 0,
      "description": "Override employee cost if different from standard"
    },
    "employer_contribution": {
      "type": "number",
      "default": 0,
      "description": "Override employer cost if different from standard"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "terminated"
      ],
      "default": "active"
    },
    "coverage_level": {
      "type": "string",
      "enum": [
        "employee_only",
        "employee_spouse",
        "family"
      ],
      "default": "employee_only"
    }
  },
  "required": [
    "company_id",
    "employee_id",
    "benefit_id",
    "start_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "company_id": "{{user.data.company_id}}",
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "employee_id": "{{user.data.employee_entity_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "company_id": "{{user.data.company_id}}",
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "employee_id": "{{user.data.employee_entity_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "company_id": "{{user.data.company_id}}",
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "company_id": "{{user.data.company_id}}",
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}