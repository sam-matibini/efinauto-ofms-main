{
  "name": "Part",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "part_number": {
      "type": "string",
      "description": "Unique part identifier"
    },
    "name": {
      "type": "string",
      "description": "Part name"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "engine",
        "transmission",
        "brakes",
        "suspension",
        "electrical",
        "body_parts",
        "interior",
        "exhaust",
        "cooling",
        "fuel_system",
        "filters",
        "lights",
        "tires_wheels",
        "other"
      ],
      "default": "other"
    },
    "compatible_makes": {
      "type": "string",
      "description": "Compatible car makes (comma-separated)"
    },
    "compatible_models": {
      "type": "string",
      "description": "Compatible models (comma-separated)"
    },
    "quantity": {
      "type": "number",
      "default": 0
    },
    "reorder_level": {
      "type": "number",
      "default": 5
    },
    "cost_price": {
      "type": "number"
    },
    "selling_price": {
      "type": "number"
    },
    "supplier": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "Storage location"
    },
    "image_url": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string",
      "description": "Reference to Vendor entity"
    },
    "vendor_name": {
      "type": "string",
      "description": "Vendor/Supplier name"
    },
    "vendor_phone": {
      "type": "string",
      "description": "Vendor phone number"
    },
    "vendor_email": {
      "type": "string",
      "description": "Vendor email address"
    },
    "invoice_number": {
      "type": "string",
      "description": "Purchase invoice number"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "Date of purchase"
    },
    "province": {
      "type": "string",
      "description": "Province for tax calculation"
    },
    "tax_status": {
      "type": "string",
      "enum": [
        "taxable",
        "zero_rated",
        "exempt"
      ],
      "default": "taxable",
      "description": "Tax status for purchase"
    },
    "tax_gst": {
      "type": "number",
      "default": 0,
      "description": "GST amount paid on purchase"
    },
    "tax_pst": {
      "type": "number",
      "default": 0,
      "description": "PST amount paid on purchase"
    },
    "tax_hst": {
      "type": "number",
      "default": 0,
      "description": "HST amount paid on purchase"
    },
    "tax_total": {
      "type": "number",
      "default": 0,
      "description": "Total tax amount paid"
    },
    "total_cost": {
      "type": "number",
      "default": 0,
      "description": "Cost price + taxes"
    }
  },
  "required": [
    "company_id",
    "part_number",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}