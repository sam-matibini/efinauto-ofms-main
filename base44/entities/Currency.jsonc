{
  "name": "Currency",
  "type": "object",
  "properties": {
    "iso_code": {
      "type": "string",
      "description": "ISO 4217 currency code (e.g., CAD, USD, EUR)"
    },
    "currency_name": {
      "type": "string",
      "description": "Full currency name"
    },
    "symbol": {
      "type": "string",
      "description": "Currency symbol (e.g., $, \u20ac, \u00a5)"
    },
    "decimal_places": {
      "type": "number",
      "default": 2,
      "description": "Standard decimal places"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether currency is active"
    },
    "sort_order": {
      "type": "number",
      "default": 999
    }
  },
  "required": [
    "iso_code",
    "currency_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}