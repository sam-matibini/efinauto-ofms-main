{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer entity"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "service_reminders": {
      "type": "boolean",
      "default": true,
      "description": "Send service reminder notifications"
    },
    "appointment_reminders": {
      "type": "boolean",
      "default": true,
      "description": "Send appointment reminder notifications"
    },
    "sale_status_updates": {
      "type": "boolean",
      "default": true,
      "description": "Send sale status update notifications"
    },
    "repair_status_updates": {
      "type": "boolean",
      "default": true,
      "description": "Send repair status update notifications"
    },
    "export_updates": {
      "type": "boolean",
      "default": false,
      "description": "Send export shipment update notifications"
    },
    "notification_method": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "both"
      ],
      "default": "email",
      "description": "Preferred notification method"
    },
    "reminder_days_before": {
      "type": "number",
      "default": 7,
      "description": "Days before service due to send reminder"
    }
  },
  "required": [
    "company_id",
    "customer_id"
  ],
  "rls": {}
}