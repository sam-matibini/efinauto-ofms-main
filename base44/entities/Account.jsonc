{
  "name": "Account",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "account_code": {
      "type": "string",
      "description": "Account code (e.g., 4000, 5000)"
    },
    "account_name": {
      "type": "string",
      "description": "Account name"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "asset",
        "liability",
        "equity",
        "revenue",
        "expense",
        "bank",
        "credit_card"
      ],
      "description": "Account type"
    },
    "account_category": {
      "type": "string",
      "enum": [
        "cash",
        "accounts_receivable",
        "inventory",
        "fixed_assets",
        "accounts_payable",
        "sales_revenue",
        "service_revenue",
        "cost_of_goods_sold",
        "operating_expenses",
        "bank",
        "credit_card",
        "other"
      ],
      "default": "other"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Current account balance"
    },
    "parent_account_id": {
      "type": "string",
      "description": "Parent account for sub-accounts"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string"
    },
    "is_bank_account": {
      "type": "boolean",
      "default": false,
      "description": "Indicates if this account has banking features enabled"
    },
    "bank_details": {
      "type": "object",
      "description": "Banking-specific details if is_bank_account is true",
      "properties": {
        "institution_name": {
          "type": "string"
        },
        "account_number": {
          "type": "string"
        },
        "routing_number": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "default": "CAD"
        }
      }
    }
  },
  "required": [
    "company_id",
    "account_code",
    "account_name",
    "account_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    }
  }
}