{
  "name": "Subdivision",
  "type": "object",
  "properties": {
    "iso_code": {
      "type": "string",
      "description": "ISO 3166-2 code (e.g., CA-ON, US-CA)"
    },
    "country_iso2": {
      "type": "string",
      "description": "Parent country ISO code"
    },
    "subdivision_name": {
      "type": "string",
      "description": "Province/State/Region name"
    },
    "subdivision_type": {
      "type": "string",
      "enum": [
        "province",
        "state",
        "territory",
        "region",
        "district"
      ],
      "description": "Type of subdivision"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether subdivision is active"
    },
    "sort_order": {
      "type": "number",
      "default": 999
    }
  },
  "required": [
    "iso_code",
    "country_iso2",
    "subdivision_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}