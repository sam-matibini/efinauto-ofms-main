{
  "name": "LocalShipment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "shipment_type": {
      "type": "string",
      "enum": [
        "LOCAL",
        "LONG_HAUL"
      ],
      "description": "Type of shipment"
    },
    "shipment_number": {
      "type": "string",
      "description": "Unique shipment identifier"
    },
    "origin_address": {
      "type": "string",
      "description": "Pickup address"
    },
    "origin_city": {
      "type": "string"
    },
    "origin_province": {
      "type": "string"
    },
    "origin_postal_code": {
      "type": "string"
    },
    "origin_lat": {
      "type": "number"
    },
    "origin_lng": {
      "type": "number"
    },
    "destination_address": {
      "type": "string",
      "description": "Delivery address"
    },
    "destination_city": {
      "type": "string"
    },
    "destination_province": {
      "type": "string"
    },
    "destination_postal_code": {
      "type": "string"
    },
    "destination_lat": {
      "type": "number"
    },
    "destination_lng": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "assigned",
        "in_transit",
        "near_destination",
        "delivered",
        "cancelled"
      ],
      "default": "pending",
      "description": "Shipment status"
    },
    "driver_id": {
      "type": "string",
      "description": "Reference to Driver entity"
    },
    "truck_id": {
      "type": "string",
      "description": "Reference to TruckVehicle entity"
    },
    "trailer_id": {
      "type": "string",
      "description": "Reference to Trailer entity"
    },
    "commodities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "weight_kg": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "hazmat": {
            "type": "boolean"
          },
          "hazmat_class": {
            "type": "string"
          },
          "hazmat_un_number": {
            "type": "string"
          }
        }
      },
      "description": "List of commodities being transported"
    },
    "total_weight_kg": {
      "type": "number",
      "description": "Total weight of all commodities"
    },
    "contains_hazmat": {
      "type": "boolean",
      "default": false,
      "description": "Whether shipment contains hazardous materials"
    },
    "hazmat_compliance": {
      "type": "object",
      "properties": {
        "placards_displayed": {
          "type": "boolean"
        },
        "driver_hazmat_certified": {
          "type": "boolean"
        },
        "emergency_response_guide_available": {
          "type": "boolean"
        },
        "spill_kit_onboard": {
          "type": "boolean"
        },
        "vehicle_inspected": {
          "type": "boolean"
        },
        "compliance_checked_by": {
          "type": "string"
        },
        "compliance_checked_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "HAZMAT compliance checklist"
    },
    "tracking_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether live GPS tracking is enabled"
    },
    "tracking_token": {
      "type": "string",
      "description": "Secure token for public tracking link"
    },
    "tracking_link_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Tracking link expiration"
    },
    "scheduled_pickup_time": {
      "type": "string",
      "format": "date-time"
    },
    "scheduled_delivery_time": {
      "type": "string",
      "format": "date-time"
    },
    "actual_pickup_time": {
      "type": "string",
      "format": "date-time"
    },
    "actual_delivery_time": {
      "type": "string",
      "format": "date-time"
    },
    "estimated_arrival": {
      "type": "string",
      "format": "date-time",
      "description": "AI-predicted ETA"
    },
    "distance_km": {
      "type": "number",
      "description": "Total distance"
    },
    "pod_id": {
      "type": "string",
      "description": "Reference to ProofOfDelivery entity"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "special_instructions": {
      "type": "string"
    },
    "reference_number": {
      "type": "string",
      "description": "Customer reference or PO number"
    }
  },
  "required": [
    "company_id",
    "shipment_type",
    "origin_address",
    "destination_address"
  ],
  "rls": {
    "read": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}