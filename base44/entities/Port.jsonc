{
  "name": "Port",
  "type": "object",
  "properties": {
    "un_locode": {
      "type": "string",
      "description": "UN/LOCODE (e.g., CATOR, USLAX, JPYOK)"
    },
    "port_name": {
      "type": "string",
      "description": "Official port name"
    },
    "country_iso2": {
      "type": "string",
      "description": "Country ISO code"
    },
    "subdivision_iso": {
      "type": "string",
      "description": "Province/State ISO code (optional)"
    },
    "port_type": {
      "type": "string",
      "enum": [
        "seaport",
        "airport",
        "rail_terminal",
        "road_terminal",
        "inland_port"
      ],
      "default": "seaport"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 999
    }
  },
  "required": [
    "un_locode",
    "port_name",
    "country_iso2"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}