{
  "name": "TimeOffRequest",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "employee_id": {
      "type": "string",
      "description": "Reference to Employee entity"
    },
    "employee_name": {
      "type": "string"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "vacation",
        "sick",
        "personal",
        "unpaid"
      ],
      "default": "vacation"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "days_requested": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied"
      ],
      "default": "pending"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "employee_id",
    "start_date",
    "end_date",
    "request_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "employee_id": "{{user.data.employee_entity_id}}"
        },
        {
          "company_id": "{{user.data.company_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "employee_id": "{{user.data.employee_entity_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "company_id": "{{user.data.company_id}}",
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "company_id": "{{user.data.company_id}}",
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "company_id": "{{user.data.company_id}}",
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}