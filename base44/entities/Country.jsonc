{
  "name": "Country",
  "type": "object",
  "properties": {
    "iso2_code": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 code (e.g., CA, US, JP)"
    },
    "iso3_code": {
      "type": "string",
      "description": "ISO 3166-1 alpha-3 code (e.g., CAN, USA, JPN)"
    },
    "country_name": {
      "type": "string",
      "description": "Official country name"
    },
    "currency_iso_code": {
      "type": "string",
      "description": "Default currency ISO 4217 code"
    },
    "phone_code": {
      "type": "string",
      "description": "International dialing code"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether country is active in system"
    },
    "sort_order": {
      "type": "number",
      "default": 999,
      "description": "Display order priority"
    }
  },
  "required": [
    "iso2_code",
    "country_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}