{
  "name": "Deduction",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "employee_id": {
      "type": "string",
      "description": "Reference to Employee entity"
    },
    "employee_name": {
      "type": "string"
    },
    "deduction_type": {
      "type": "string",
      "enum": [
        "loan_repayment",
        "garnishment",
        "union_dues",
        "charity",
        "other"
      ],
      "default": "other"
    },
    "description": {
      "type": "string"
    },
    "amount_per_pay": {
      "type": "number",
      "default": 0
    },
    "percentage_of_gross": {
      "type": "number",
      "default": 0,
      "description": "Alternative to fixed amount - percentage of gross pay"
    },
    "total_amount_owed": {
      "type": "number",
      "default": 0,
      "description": "Total amount to be deducted (for loans/garnishments)"
    },
    "amount_deducted_to_date": {
      "type": "number",
      "default": 0
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "suspended"
      ],
      "default": "active"
    },
    "priority": {
      "type": "number",
      "default": 1,
      "description": "Deduction priority order (1 = highest)"
    }
  },
  "required": [
    "company_id",
    "employee_id",
    "deduction_type",
    "start_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "company_id": "{{user.data.company_id}}",
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "company_id": "{{user.data.company_id}}",
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "company_id": "{{user.data.company_id}}",
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "company_id": "{{user.data.company_id}}",
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}