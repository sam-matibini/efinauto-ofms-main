{
  "name": "TransactionRule",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "rule_name": {
      "type": "string",
      "description": "User-friendly name for the rule"
    },
    "match_type": {
      "type": "string",
      "enum": [
        "contains",
        "exact",
        "starts_with",
        "ends_with",
        "regex"
      ],
      "default": "contains",
      "description": "How to match the transaction description"
    },
    "match_field": {
      "type": "string",
      "enum": [
        "description",
        "reference_number",
        "amount",
        "vendor_name"
      ],
      "default": "description",
      "description": "Which field to match against"
    },
    "match_value": {
      "type": "string",
      "description": "The value to match (e.g., 'Office Depot')"
    },
    "target_account_id": {
      "type": "string",
      "description": "The GL account to assign"
    },
    "target_account_name": {
      "type": "string",
      "description": "Account name for display"
    },
    "target_category": {
      "type": "string",
      "description": "Transaction category to assign"
    },
    "confidence_score": {
      "type": "number",
      "default": 1,
      "description": "AI confidence score (0-1)"
    },
    "times_applied": {
      "type": "number",
      "default": 0,
      "description": "Number of times this rule was applied"
    },
    "times_confirmed": {
      "type": "number",
      "default": 0,
      "description": "Number of times user confirmed the suggestion"
    },
    "times_rejected": {
      "type": "number",
      "default": 0,
      "description": "Number of times user rejected the suggestion"
    },
    "is_ai_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether this rule was generated by AI"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "pending_review"
      ],
      "default": "active"
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "Higher priority rules are applied first"
    }
  },
  "required": [
    "company_id",
    "match_value",
    "target_account_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}