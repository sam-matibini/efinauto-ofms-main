{
  "name": "EmployeeOffboarding",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "employee_id": {
      "type": "string",
      "description": "Reference to Employee entity"
    },
    "employee_name": {
      "type": "string"
    },
    "termination_date": {
      "type": "string",
      "format": "date"
    },
    "last_working_day": {
      "type": "string",
      "format": "date"
    },
    "termination_reason": {
      "type": "string",
      "enum": [
        "resignation",
        "layoff",
        "retirement",
        "dismissal",
        "end_of_contract"
      ],
      "default": "resignation"
    },
    "status": {
      "type": "string",
      "enum": [
        "initiated",
        "in_progress",
        "completed"
      ],
      "default": "initiated"
    },
    "checklist": {
      "type": "object",
      "properties": {
        "exit_interview_completed": {
          "type": "boolean",
          "default": false
        },
        "final_payroll_processed": {
          "type": "boolean",
          "default": false
        },
        "roe_generated": {
          "type": "boolean",
          "default": false
        },
        "benefits_terminated": {
          "type": "boolean",
          "default": false
        },
        "company_property_returned": {
          "type": "boolean",
          "default": false
        },
        "system_access_revoked": {
          "type": "boolean",
          "default": false
        },
        "email_archived": {
          "type": "boolean",
          "default": false
        },
        "knowledge_transfer_completed": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "assets_to_return": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_name": {
            "type": "string"
          },
          "asset_type": {
            "type": "string"
          },
          "serial_number": {
            "type": "string"
          },
          "returned": {
            "type": "boolean",
            "default": false
          },
          "return_date": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          }
        }
      }
    },
    "final_pay_amount": {
      "type": "number",
      "default": 0
    },
    "vacation_payout": {
      "type": "number",
      "default": 0
    },
    "severance_pay": {
      "type": "number",
      "default": 0
    },
    "roe_serial_number": {
      "type": "string"
    },
    "roe_generated_date": {
      "type": "string",
      "format": "date"
    },
    "notifications_sent": {
      "type": "object",
      "properties": {
        "hr_notified": {
          "type": "boolean",
          "default": false
        },
        "it_notified": {
          "type": "boolean",
          "default": false
        },
        "finance_notified": {
          "type": "boolean",
          "default": false
        },
        "manager_notified": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "employee_id",
    "termination_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}