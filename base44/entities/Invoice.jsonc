{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "invoice_number": {
      "type": "string",
      "description": "Unique invoice number"
    },
    "repair_order_id": {
      "type": "string",
      "description": "Reference to RepairOrder entity"
    },
    "repair_order_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "vehicle_details": {
      "type": "string",
      "description": "Vehicle make, model, year, VIN"
    },
    "service_date": {
      "type": "string",
      "format": "date"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "labor_hours": {
      "type": "number",
      "default": 0
    },
    "labor_rate": {
      "type": "number",
      "default": 0
    },
    "labor_cost": {
      "type": "number",
      "default": 0
    },
    "parts_cost": {
      "type": "number",
      "default": 0
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "balance_due": {
      "type": "number",
      "default": 0
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "partial",
        "paid"
      ],
      "default": "pending"
    },
    "payment_terms": {
      "type": "string",
      "default": "Due upon receipt"
    },
    "notes": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL to generated PDF invoice"
    },
    "email_sent": {
      "type": "boolean",
      "default": false
    },
    "email_sent_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_id",
    "invoice_number",
    "customer_name"
  ],
  "rls": {
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}