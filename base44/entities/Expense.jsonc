{
  "name": "Expense",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "expense_number": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "office_supplies",
        "utilities",
        "rent",
        "insurance",
        "advertising",
        "travel",
        "meals",
        "fuel",
        "maintenance",
        "other"
      ],
      "default": "other"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number"
    },
    "expense_date": {
      "type": "string",
      "format": "date"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "credit_card",
        "debit_card",
        "check",
        "bank_transfer",
        "other"
      ],
      "default": "cash"
    },
    "reference_number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "cancelled"
      ],
      "default": "paid"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "amount",
    "expense_date"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}