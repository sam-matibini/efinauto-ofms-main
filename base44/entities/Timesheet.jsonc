{
  "name": "Timesheet",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "technician_id": {
      "type": "string",
      "description": "Reference to Technician entity"
    },
    "technician_name": {
      "type": "string"
    },
    "repair_order_id": {
      "type": "string",
      "description": "Reference to RepairOrder entity"
    },
    "repair_order_number": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "clock_in": {
      "type": "string",
      "description": "Clock in time (HH:MM)"
    },
    "clock_out": {
      "type": "string",
      "description": "Clock out time (HH:MM)"
    },
    "total_hours": {
      "type": "number",
      "default": 0
    },
    "task_description": {
      "type": "string"
    },
    "billable": {
      "type": "boolean",
      "default": true
    },
    "approved": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "technician_id",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.company_id": "{{user.data.company_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.company_id": "{{user.data.company_id}}"
            },
            {
              "user_condition": {
                "role": "manager"
              }
            }
          ]
        }
      ]
    }
  }
}