{
  "name": "FreightShipment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "export_id": {
      "type": "string",
      "description": "Reference to Export entity"
    },
    "shipment_number": {
      "type": "string",
      "description": "Unique shipment reference"
    },
    "seal_number": {
      "type": "string",
      "description": "Seal number"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "shipment_type": {
      "type": "string",
      "enum": [
        "air",
        "sea",
        "land",
        "rail"
      ],
      "default": "sea"
    },
    "cargo_type": {
      "type": "string",
      "enum": [
        "vehicle",
        "parts",
        "general_cargo",
        "hazardous",
        "refrigerated"
      ],
      "default": "vehicle"
    },
    "origin_location": {
      "type": "string"
    },
    "origin_country": {
      "type": "string"
    },
    "destination_location": {
      "type": "string"
    },
    "destination_country": {
      "type": "string"
    },
    "cargo_description": {
      "type": "string"
    },
    "cargo_items": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Array of cargo items from export"
    },
    "number_of_items": {
      "type": "number",
      "default": 1
    },
    "total_weight": {
      "type": "number",
      "description": "Weight in kg"
    },
    "total_volume": {
      "type": "number",
      "description": "Volume in cubic meters"
    },
    "cargo_value": {
      "type": "number"
    },
    "freight_cost": {
      "type": "number"
    },
    "insurance_cost": {
      "type": "number",
      "default": 0
    },
    "handling_fees": {
      "type": "number",
      "default": 0
    },
    "customs_fees": {
      "type": "number",
      "default": 0
    },
    "total_cost": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "booked",
        "picked_up",
        "in_transit",
        "customs_clearance",
        "out_for_delivery",
        "delivered",
        "cancelled"
      ],
      "default": "booked"
    },
    "pickup_date": {
      "type": "string",
      "format": "date"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "expected_arrival": {
      "type": "string",
      "format": "date"
    },
    "actual_delivery": {
      "type": "string",
      "format": "date"
    },
    "carrier_name": {
      "type": "string",
      "description": "Shipping company/carrier"
    },
    "vessel_flight_number": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    },
    "container_number": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "partial",
        "paid"
      ],
      "default": "pending"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of shipping documents (BOL, invoice, etc.)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "customer_name",
    "origin_country",
    "destination_country"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}